# Dostawca: mock (testowy, bez konta) albo sogni
PROVIDER=mock

# Klucz Sogni (https://dashboard.sogni.ai/api-key). Tylko tutaj, nigdy w kodzie ani na czacie.
SOGNI_API_KEY=

# Sensitive Content Filter Sogni. false wymaga uprawnionego konta 18+.
# Program NIE ponawia zadan z inna wartoscia po odmowie.
SAFE_CONTENT_FILTER=true

# billing_mode: subscription = tylko plan Unlimited, bez wydawania Spark/SOGNI.
SOGNI_BILLING_MODE=subscription
SOGNI_MAX_CAPACITY_UNITS=40

IMAGE_MODEL=krea-2-turbo
EDIT_MODEL=krea-identity-edit
VIDEO_MODEL=ltx25
VIDEO_DURATION=5

# Niezweryfikowane nazwy argumentow Sogni (sprawdz w Etapie 0):
SOGNI_EDIT_REF_ARG=contextImageIndices
SOGNI_IMAGE_ARGS={}
SOGNI_VIDEO_ARGS={}

MAX_IMAGE_JOBS=4
MAX_VIDEO_JOBS=1
MAX_ATTEMPTS_PER_SHOT=6
MAX_REFS=3

# Pomiar twarzy InsightFace (miara orientacyjna, wymaga requirements-face.txt)
FACE_GUARD=true

# Model jezykowy asystenta (lista: GET /v1/models z Twoim kluczem); rozliczany z planu
LLM_MODEL=qwen3.6-35b-a3b-gguf-iq4xs

# Film: budzet jednego uruchomienia produkcji (Spark wartosci z licznika planu), proby na zadanie, przerwa przy limicie
FILM_BUDGET_SPARK=400
FILM_MAX_TASK_ATTEMPTS=3
FILM_PAUSE_MINUTES=20

# Duet (dwie osoby w kadrze): model edycji dla pary (>= 2 referencje), limit referencji i domyslna pozycja z biblioteki interakcji.
# Domyslne modele powyzej bez zmian; to sa nowe klucze.
PARTNER_MODEL=qwen
DUET_MAX_REFS=3
INTERACTION_DEFAULT=standing embrace

# Ile razy wznowic workflow wstrzymany przez przeglad bezpieczenstwa (safety_review_required) z safe_content_filter=false.
# 0 = nie wznawiaj. Zwykle odmowy (status failed) nie sa ponawiane nigdy.
SAFETY_RESUME_ATTEMPTS=2
